{
  "$schema": "https://libraries.horizon36596.org/zenith/schema/v1/auto.json",
  "formatVersion": 4,
  "name": "preload-cycle-park",
  "title": "Preload, cycle and park",
  "description": "Launch the four preloaded pollen from south of the RED hive, collect four more from the RED garden in one intake pass, launch them from north of the hive once it has tipped, and park.",
  "robot": "autos/robot.json",
  "field": "autos/field/biobuzz.field.json",
  "alliance": "RED",
  "authors": [
    "Horizon (FTC 36596)"
  ],
  "created": "2026-09-28",
  "start": {
    "pose": {
      "ref": "start"
    },
    "holds": {
      "pollen": 4
    }
  },
  "steps": [
    {
      "id": "toShoot",
      "kind": "path",
      "segments": [
        {
          "kind": "line",
          "from": {
            "ref": "start"
          },
          "to": {
            "ref": "shootSouth"
          }
        }
      ],
      "heading": {
        "mode": "linear",
        "fromRad": -1.5708,
        "toRad": -2.1967
      },
      "notes": "Backs off the wall to the shoot spot south of the hive, where the hive's up cell faces at the start. The launcher is at the back of the robot, so the robot turns its back to the hive on the way."
    },
    {
      "id": "shootPreload",
      "kind": "command",
      "name": "shootAll",
      "args": {
        "count": 4
      },
      "notes": "Launches the four preloaded pollen with the default precise cadence. Three pollen on top of the three red nectar tip the hive, so its up cell now faces north."
    },
    {
      "id": "toGarden",
      "kind": "path",
      "segments": [
        {
          "kind": "bezier",
          "from": "current",
          "control": [
            {
              "xIn": -44,
              "yIn": -52,
              "provenance": "PLACEHOLDER: a curve control point that leaves the shoot spot nose-first"
            },
            {
              "xIn": -42,
              "yIn": -61.5,
              "provenance": "PLACEHOLDER: a curve control point that brings the robot level with the garden row"
            }
          ],
          "to": {
            "ref": "intakeStart"
          }
        }
      ],
      "heading": {
        "mode": "linear",
        "fromRad": -2.1967,
        "toRad": -3.1416
      },
      "notes": "Drives to the east end of the garden row, turning as it goes, so the robot is level with the row before it gets near the wall."
    },
    {
      "id": "sweepGarden",
      "kind": "path",
      "segments": [
        {
          "kind": "line",
          "from": "current",
          "to": {
            "ref": "intakeEnd"
          }
        }
      ],
      "heading": {
        "mode": "tangent"
      },
      "speedFraction": 0.4,
      "markers": [
        {
          "at": {
            "t": 0
          },
          "command": {
            "name": "setIntake",
            "args": {
              "side": "FRONT",
              "state": "FORWARD"
            }
          }
        }
      ],
      "endCondition": {
        "condition": "hopperFull"
      },
      "expect": {
        "collectFrom": "gardenRed",
        "count": 4
      },
      "notes": "Drives slowly along the garden row with the intake leading. The marker starts the intake as the path starts, and the path ends early once the hopper is full."
    },
    {
      "id": "stopIntake",
      "kind": "command",
      "name": "setIntake",
      "args": {
        "side": "FRONT",
        "state": "STOP"
      },
      "notes": "Stops the intake before the drive back."
    },
    {
      "id": "toShootNorth",
      "kind": "path",
      "segments": [
        {
          "kind": "line",
          "from": "current",
          "to": {
            "ref": "shootNorth"
          }
        }
      ],
      "heading": {
        "mode": "piecewise",
        "ranges": [
          {
            "startT": 0,
            "endT": 0.15,
            "heading": {
              "mode": "linear",
              "fromRad": 3.1416,
              "toRad": 1.3885
            }
          },
          {
            "startT": 0.15,
            "endT": 0.85,
            "heading": {
              "mode": "tangent"
            }
          },
          {
            "startT": 0.85,
            "endT": 1,
            "heading": {
              "mode": "linear",
              "fromRad": 1.3885,
              "toRad": 2.1967
            }
          }
        ]
      },
      "notes": "Drives up the west side of the field, clear of the hive, to the shoot spot north of it. The hive tipped on the first shot, so its up cell can only be scored from this side now."
    },
    {
      "id": "shootCollected",
      "kind": "command",
      "name": "shootAll",
      "args": {
        "count": 4,
        "cadence": "rapid"
      },
      "notes": "Launches the four collected pollen into the up cell, now the north one, with the rapid cadence."
    },
    {
      "id": "park",
      "kind": "path",
      "segments": [
        {
          "kind": "line",
          "from": "current",
          "to": {
            "ref": "park"
          }
        }
      ],
      "heading": {
        "mode": "tangentReversed"
      },
      "markers": [
        {
          "at": {
            "t": 0
          },
          "command": {
            "name": "launcherIdle"
          }
        }
      ],
      "notes": "Backs away from the north shoot spot and parks. The marker drops the launcher to idle as the path starts."
    }
  ]
}
